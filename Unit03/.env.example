# ==============================================================================
# DEVOP2 - Unit 03 - template for .env.dev / .env.staging / .env.prod
# ==============================================================================
# cp .env.example .env.dev   (same for staging / prod) and set real values.
# The .env.* files are git-ignored; only this .example file is versioned.
# Convention: the dummy value of a secret = the variable name itself.
# Used by loader_env.py:  APP_ENV=staging python loader_env.py
# ==============================================================================
DB_URL="postgresql://APP_USER:PASSWORD_DB@localhost:5432/APP_DB"
API_KEY="PASSWORD_API_KEY"
DEBUG=true

# ==============================================================================
# DEVOP2 - Unit 02 - Environment template (dummy values only)
# ==============================================================================
# cp .env.example .env   then replace every PASSWORD_* value in .env.
# .env is ignored by Git (.gitignore); this .example file is versioned.
# Convention: the dummy value of a password = the variable name itself.
# (Replaces the former "dot_env" template.)
# ==============================================================================

# Elastic Stack version (Elasticsearch and Kibana must use the same one)
STACK_VERSION=8.15.3

# Password of the "elastic" superuser (used by curl / browser login)
PASSWORD_ELASTIC=PASSWORD_ELASTIC

# Password of the built-in kibana_system account (used by Kibana only).
# Set it once with:
#   docker exec -it elasticsearch bin/elasticsearch-reset-password -u kibana_system -i
PASSWORD_KIBANA=PASSWORD_KIBANA

# Elasticsearch HTTP Host Port (Default 9200 + 1 = 9201)
ES_PORT_EXPOSE=9201
ES_PORT_IN=9200

# Elasticsearch Transport Host Port (Default 9300 + 1 = 9301)
ES_TRANSPORT_PORT_EXPOSE=9301
ES_TRANSPORT_PORT_IN=9300

# Kibana Host Port (Default 5601 + 1 = 5602)
KIBANA_PORT_EXPOSE=5602
KIBANA_PORT_IN=5601

# Cluster Architecture Configuration
CLUSTER_NAME=lab-cluster
NODE_NAME=elasticsearch
DISCOVERY_TYPE=single-node

# JVM Memory Cap (Recommended: 1GB minimum)
ES_JAVA_OPTS="-Xms1g -Xmx1g"

# Service-account token alternative (not used: TLS + kibana_system kept)
#ELASTICSEARCH_SERVICEACCOUNTTOKEN=PASSWORD_ELASTICSEARCH_SERVICEACCOUNTTOKEN

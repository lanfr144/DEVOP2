# ==============================================================================
# DEVOP2 - Unit 04 - Environment template (dummy values only)
# ==============================================================================
# cp .env.example .env   then set the three values in .env.
# .env is ignored by Git (../.gitignore); this .example file is versioned.
# Convention: the dummy value of a secret = the variable name itself.
# ==============================================================================

# Identity written in the commits made inside the container
GIT_USER_NAME=GIT_USER_NAME
GIT_USER_EMAIL=GIT_USER_EMAIL

# GitHub personal access token used by gh and by "git push".
# Create it on GitHub: Settings > Developer settings > Personal access tokens.
# Scopes: repo (Unit 05 also needs delete_repo, the script removes its test repository).
# Never paste this token anywhere else than in .env.
GH_TOKEN=PASSWORD_GH_TOKEN

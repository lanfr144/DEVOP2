# ==============================================================================
# DEVOP2 - Unit 01 - Environment template (dummy values only)
# ==============================================================================
# cp .env.example .env   then replace every PASSWORD_* value in .env.
# .env is ignored by Git (.gitignore); this .example file is versioned.
# Convention: the dummy value of a password = the variable name itself.
# ==============================================================================

# MongoDB Credentials
MONGO_ROOT_USER=admin
PASSWORD_MONGO_ROOT=PASSWORD_MONGO_ROOT

# MongoDB Port Mapping (HOST_PORT:CONTAINER_PORT)
MONGO_HOST_PORT=27018
MONGO_CONTAINER_PORT=27017

# Mongo Express Web UI Credentials
EXPRESS_BASICAUTH_USER=admin
PASSWORD_EXPRESS_BASICAUTH=PASSWORD_EXPRESS_BASICAUTH

# Mongo Express Port Mapping (HOST_PORT:CONTAINER_PORT)
EXPRESS_HOST_PORT=8082
EXPRESS_CONTAINER_PORT=8081
